// Общий код пост-эффекта «Сырой свет»: цвет «мокрого натурализма» с плёночной печатью.
// Тени уходят в бутылочно-бирюзовый кафель, света — в кремовый; тёплое (огонь, свечи, натрий) сохраняет цвет,
// остальное приглушено. Чёрное — не цифровой ноль, а плотный бирюзовый «пол» плёнки (2–4/255), по которому
// бежит зерно 24 раза в секунду: тьма фактурная, в ней «мерещится». Работает в экранном (sRGB) пространстве.

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
const vec3 SHADOW_TINT = vec3(0.84, 1.0, 0.97);
const vec3 HIGH_TINT = vec3(1.07, 0.98, 0.86);
const vec3 TOE = vec3(0.010, 0.015, 0.015);

// Хеш без sin (Хоскинс): sin-хеш давал вертикальную полосатость зерна на некоторых драйверах.
float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = hash12(i);
	float b = hash12(i + vec2(1.0, 0.0));
	float c = hash12(i + vec2(0.0, 1.0));
	float d = hash12(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// «Печать»: избирательная насыщенность (тёплое сохраняется), раздельное тонирование, пол чёрного.
vec3 film_grade(vec3 col, float bk) {
	float l = dot(col, LUMA);
	float warm = smoothstep(0.03, 0.2, col.r - col.b);
	col = mix(vec3(l), col, mix(0.72, 1.0, warm));
	col *= mix(SHADOW_TINT, HIGH_TINT, smoothstep(0.03, 0.45, l));
	return TOE * bk + col * (1.0 - TOE);
}

// Зерно позитива: смена 24 раза в секунду (не каждый кадр 180-герцового монитора), сильнее в тенях и средних
// тонах, симметрично вокруг пола — не только светлеет. Дизеринг ±0.5/255 против полос в тёмных градиентах тумана.
// Сдвиг хеша по кадрам ограничен (< 1024 px): с растущим t вход hash12 уходил за 1e5, fp32 переставал различать
// соседние пиксели и через несколько минут зерно становилось сеткой 97×97 px. Цикл 4096 кадров (~170 с) не виден.
vec3 film_grain(vec3 col, vec2 frag, float t, float amount) {
	float frame = mod(floor(t * 24.0), 4096.0);
	vec2 off = floor(fract(vec2(0.7548777, 0.5698403) * frame) * 1024.0);
	float l = dot(col, LUMA);
	float g = hash12(frag + off) - 0.5;
	col += g * amount * (1.3 - l);
	col += (hash12(frag * 1.37 + off.yx + 7.0) - 0.5) / 255.0;
	return col;
}
